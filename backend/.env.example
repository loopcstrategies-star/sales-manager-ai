PORT=5100
MONGO_URI=mongodb://127.0.0.1:27017/sales-manager-ai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# --- Recommended free stack: Groq LLM + Brave search ---
SALES_AI_SYNTHESIS_MODE=auto
# auto = use LLM when GROQ_API_KEY or OPENAI_API_KEY is set; template fallback otherwise
# openai = always use LLM (falls back to template on error)
# template = template only (no LLM)

SALES_AI_MAX_TAVILY_SEARCHES=2
CHAT_RATE_LIMIT_MAX=20
SEARCH_CACHE_TTL_HOURS=24

# Web search (Brave free tier ~2000 queries/month recommended)
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
TAVILY_API_KEY=

# Groq free LLM (https://console.groq.com)
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_SALES_AI_MODEL=llama-3.3-70b-versatile
# Or set OPENAI_API_KEY to your Groq key instead of GROQ_API_KEY

# Paid OpenAI (optional alternative)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_SALES_AI_MODEL=gpt-4o-mini

# Optional Hunter.io for verified domain emails (Account → Hunter emails)
HUNTER_API_KEY=

# Local Ollama (optional alternative)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_SALES_AI_MODEL=llama3.2

EMBED_TOKEN_SECRET=change-me-embed-secret

# Production (Railway / Vercel proxy)
TRUST_PROXY=true

# Dashboard (Tavily + Groq market cards)
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH_HOURS=4
DASHBOARD_MANUAL_REFRESH_COOLDOWN_MIN=10
DASHBOARD_QUERY_COUNT=8
DASHBOARD_CARD_CAP=20
# Lower TPM usage for Groq free tier
DASHBOARD_LLM_MAX_TOKENS=1500
# Optional: llama-3.1-8b-instant uses fewer tokens than 70b
# DASHBOARD_LLM_MODEL=llama-3.1-8b-instant
DASHBOARD_LLM_INPUT_CHARS=8000
DASHBOARD_LLM_MAX_SOURCES=20
DASHBOARD_LLM_SNIPPET_CHARS=200

# Optional: live gold/silver prices (https://www.goldapi.io)
GOLDAPI_KEY=

# Optional: extra headlines (https://newsapi.org)
NEWSAPI_KEY=
METALS_PRICE_CACHE_MIN=30

# CRM import / enrich / webhooks
# Shared secret for POST /api/crm/webhooks/lead (header X-CRM-Webhook-Secret)
CRM_WEBHOOK_SECRET=
# Default workspace/owner when webhook body omits them
CRM_WEBHOOK_WORKSPACE_ID=
CRM_WEBHOOK_OWNER_ID=
# Nightly-ish re-enrich of stale leads/accounts (overwrite=false)
CRM_ENRICH_REFRESH_ENABLED=true
CRM_ENRICH_REFRESH_HOURS=24
CRM_ENRICH_REFRESH_CAP=50
CRM_ENRICH_STALE_DAYS=30
